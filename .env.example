# PostgreSQL (plain URL; async/sync driver URLs are derived in app/config.py)
POSTGRES_USER=support
POSTGRES_PASSWORD=change-me
POSTGRES_DB=support
DATABASE_URL=postgresql://support:change-me@postgres:5432/support

# RabbitMQ
RABBITMQ_DEFAULT_USER=support
RABBITMQ_DEFAULT_PASS=change-me
CELERY_BROKER_URL=amqp://support:change-me@rabbitmq:5672//

# Redis (global LLM rate limiter)
REDIS_URL=redis://redis:6379/0

# LLM (empty key = no-key mode)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
LLM_BASE_URL=https://api.openai.com/v1
# Global limit of LLM requests per minute (both modes)
LLM_RATE_LIMIT=60

# Helpdesk
HELPDESK_TIMEOUT=5

# Operator UI HTTP Basic Auth (required; set a strong password)
OPERATOR_USER=operator
OPERATOR_PASSWORD=change-me

# Helpdesk mock: share of 500s, share of slow answers (stored, then delayed),
# and the delay in seconds (must exceed HELPDESK_TIMEOUT)
MOCK_ERROR_RATE=0.2
MOCK_SLOW_RATE=0.1
MOCK_SLOW_SECONDS=8

# API async DB pool (per uvicorn process)
API_DB_POOL_SIZE=20
API_DB_MAX_OVERFLOW=10

# Celery worker threads; also the size of the sync DB pool
WORKER_CONCURRENCY=20

# Public domain for Caddy (docker-compose.prod.yml only), e.g. <ip-with-dashes>.sslip.io
DOMAIN=

# Retries
MAX_GENERATE_ATTEMPTS=5
MAX_SEND_ATTEMPTS=5
