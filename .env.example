# PostgreSQL (plain URL; async/sync driver URLs are derived in app/config.py)
POSTGRES_USER=support
POSTGRES_PASSWORD=change-me
POSTGRES_DB=support
DATABASE_URL=postgresql://support:change-me@postgres:5432/support

# RabbitMQ
RABBITMQ_DEFAULT_USER=support
RABBITMQ_DEFAULT_PASS=change-me
CELERY_BROKER_URL=amqp://support:change-me@rabbitmq:5672//

# Redis (global LLM rate limiter)
REDIS_URL=redis://redis:6379/0

# LLM (empty key = no-key mode)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
LLM_BASE_URL=https://api.openai.com/v1
# Global limit of LLM requests per minute (both modes)
LLM_RATE_LIMIT=60

# Helpdesk
HELPDESK_TIMEOUT=5

# Retries
MAX_GENERATE_ATTEMPTS=5
MAX_SEND_ATTEMPTS=5
